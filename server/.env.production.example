# Generate a secure 64-byte secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_random_jwt_key_here_change_me

# Allowed client origins separated by commas (supports multiple domains or same-origin)
CLIENT_ORIGIN=https://learnai123.duckdns.org,http://localhost:5173

# Server Port
PORT=4000

# Environment mode
NODE_ENV=production

# Custom persistent data path (optional, defaults to ./data.json)
# DATA_FILE_PATH=/var/data/messenger/data.json
